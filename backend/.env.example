# Backend (FastAPI) settings. Copy this file to backend/.env and fill in your values. Never commit .env.
# (A .env at the repository root is still read as a fallback, so older setups keep working.)

# Shared secret: the frontend sends it in the X-API-Token header. Set the same value in
# frontend/.env. Required for any deployment other than your own machine.
# BACKEND_API_TOKEN=change-me-to-a-long-random-string

# LLM provider: "openrouter" (default), "google_genai", "anthropic" or "openai"
LLM_PROVIDER=openrouter
# OpenRouter OpenAI-compatible API endpoint (plain URL, without Markdown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model name for that provider (OpenRouter uses vendor/model ids)
LLM_MODEL=google/gemini-2.5-flash
# API key for the chosen provider (only the one you use is required)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Google AI Studio free tier instead of OpenRouter: get a key at aistudio.google.com/apikey and set
#   LLM_PROVIDER=google_genai
#   LLM_MODEL=gemini-2.5-flash
#   GOOGLE_API_KEY=your-google-api-key-here
# The free tier has low per-minute and per-day limits, and Google may use free-tier prompts to
# improve its products, so use it for the synthetic demo data, not real attendee data.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# Sampling temperature (0 = most consistent)
# LLM_TEMPERATURE=0

# Optional: folder holding the eight dataset CSVs (defaults to data/synthetic,
# which is generated automatically on first run if it is missing)
# CONFERATLAS_DATA_DIR=data/synthetic

# Largest accepted upload, per CSV file, in MB
# MAX_UPLOAD_MB=200

# --- AI request limits (optional) ---
# Seconds before one AI request is abandoned
# LLM_TIMEOUT_SECONDS=60
# Extra attempts after a timeout, rate limit or overload, with exponential backoff
# LLM_MAX_RETRIES=2
# Maximum tokens in each AI response
# LLM_MAX_OUTPUT_TOKENS=1000  (keep it set: OpenRouter reserves credit for the full output budget)
# (on google_genai the free tier costs nothing; leave the prices below empty or set them to 0)

# --- Cost estimates in the sidebar "AI usage" panel (optional) ---
# USD per million tokens for your model. Copy the current figures from your provider's
# pricing page; without them the panel still shows tokens and latency, just not cost.
# LLM_INPUT_PRICE_PER_MTOK=
# LLM_OUTPUT_PRICE_PER_MTOK=

# --- Other OpenAI-compatible chat providers (optional) ---
# Nebius (cohort credits): copy the base URL from your Nebius console (it ends in /v1).
#   LLM_PROVIDER=nebius
#   LLM_MODEL=<chat model id from the Nebius model list>
# NEBIUS_API_KEY=your-nebius-api-key-here
# NEBIUS_BASE_URL=
# Fireworks AI (backup): the base URL defaults to https://api.fireworks.ai/inference/v1
# FIREWORKS_API_KEY=your-fireworks-api-key-here

# --- RAG: document search (Week 2) ---
# Embedding provider: "nebius", "fireworks", "openai" or "google_genai" (uses the matching
# key above). Leave empty to turn document search off; the dashboards still work.
# EMBEDDING_PROVIDER=nebius
# Embedding model id exactly as your provider lists it (Google: gemini-embedding-2)
# EMBEDDING_MODEL=
# Folder for the Chroma vector index (rebuilt by scripts/build_index.py; ignored by Git)
# CONFERATLAS_INDEX_DIR=data/index

# --- Evaluation (Week 2, scripts/run_eval.py) ---
# Model that grades answers for faithfulness, relevance and correctness, from the same provider as
# the answers and ideally a different model family (default zai-org/GLM-5.3 on Nebius; answers are
# graded from deepseek-ai/DeepSeek-V4-Flash-0731, the run_eval.py --answer-model default).
# EVAL_JUDGE_MODEL=zai-org/GLM-5.3

# --- LangSmith tracing and evaluation (optional) ---
# Traces include prompts and retrieved text: keep tracing on for the synthetic demo data only.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=conferatlas
# EU accounts only:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

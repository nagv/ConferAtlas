# Frontend (Streamlit) settings. Copy this file to frontend/.env. Never commit .env.
# The frontend holds no model keys: all data and AI work happens in the backend.

# Where the backend API runs (Docker Compose sets http://backend:8000 for you)
BACKEND_URL=http://127.0.0.1:8000
# Must match BACKEND_API_TOKEN in backend/.env when the backend requires a token
# BACKEND_API_TOKEN=change-me-to-a-long-random-string
# Seconds to wait for an AI request (feedback analysis can take a few minutes)
# AI_HTTP_TIMEOUT_S=600

# --- Staff access ---
# The local synthetic demo works without sign-in. Remote or custom-data deployments
# always require OIDC staff sign-in; false cannot bypass those checks.
# CONFERATLAS_REQUIRE_AUTH=true
# CONFERATLAS_STAFF_EMAILS=staff1@example.com,staff2@example.com
# Configure the identity provider in frontend/.streamlit/secrets.toml
# (see frontend/.streamlit/secrets.toml.example).

# Streamlit Community Cloud: app Settings > Secrets.
# Copy these TOP-LEVEL settings before any [auth] or other TOML section.
# Replace the URL and token; the token must match BACKEND_API_TOKEN on Render.
BACKEND_URL = "https://YOUR_RENDER_SERVICE.onrender.com"
BACKEND_API_TOKEN = "REPLACE_WITH_THE_RENDER_BACKEND_API_TOKEN"
CONFERATLAS_PUBLIC_DEMO = true
CONFERATLAS_REQUIRE_AUTH = false

# No [auth] section is needed for this synthetic public demo.
# On Render, leave CONFERATLAS_DATA_DIR unset to use the built-in synthetic data.
# Uploads and custom data still require staff sign-in.
# Public visitors can use AI features if the backend has an AI provider key configured.
